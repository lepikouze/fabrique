#!/usr/bin/env python3
"""Fake Codex CLI (codex exec --json) for the runner tests: JSONL events, fab, a change to the repo."""
import json, os, subprocess, sys
args = sys.argv[1:]
assert args[0] == "exec"
resume = args[args.index("resume") + 1] if "resume" in args else None
assert "--dangerously-bypass-approvals-and-sandbox" in args and args.index("--json") < (args.index("resume") if resume else len(args))
prompt = args[-1]
FAB = [sys.executable, os.path.join(os.path.dirname(__file__), "..", "..", "runner", "fab.py")]
def out(o): print(json.dumps(o), flush=True)
def fab(*a): subprocess.run(FAB + list(a), check=True, capture_output=True)
assert os.path.isdir(os.environ["CODEX_HOME"]) and os.environ.get("FAB_MODEL_KEY")
cfg = [args[i + 1] for i, a in enumerate(args) if a == "-c"]
assert 'model_provider="fabrique"' in cfg and any(c.startswith("model_providers.fabrique=") for c in cfg)
assert resume or "<fabrique_instructions>" in prompt
out({"type": "thread.started", "thread_id": resume or "thr-codex-1"})
out({"type": "turn.started"})
out({"type": "item.started", "item": {"id": "i1", "type": "command_execution", "command": "bash -lc ls", "status": "in_progress"}})
fab("step", "triage", "compris (codex)")
with open("notebook.py", "w") as f:
    f.write("def ok():\n    return True\n")
out({"type": "item.completed", "item": {"id": "i2", "type": "file_change", "changes": [{"path": "notebook.py", "kind": "update"}]}})
subprocess.run(["git", "add", "-A"], check=True)
subprocess.run(["git", "commit", "-qm", "changement de codex"], check=True, capture_output=True)
fab("decision", "--confident", "yes", "--verdict", "fait", "--interpretation", "compris")
out({"type": "item.completed", "item": {"id": "i3", "type": "agent_message", "text": "fini"}})
out({"type": "turn.completed", "usage": {"input_tokens": 100000, "cached_input_tokens": 50000, "output_tokens": 10000}})
