# Fabrique — optional variables from the compose.yaml file. Copy to ".env" and adapt. None are mandatory.

# Stack name: change it to run two instances of Fabrique on the same host (distinct networks, volumes, and containers).
# COMPOSE_PROJECT_NAME=fabrique

# Images: by default built from this repo (docker compose --profile images build). To pull them from a registry:
# FABRIQUE_IMAGES=ghcr.io/<owner>          # images published by the GitHub Actions workflow
# FABRIQUE_TAG=latest

# Public dashboard address (notification links, SSO callback) and port published on the host.
# PUBLIC_URL=https://fabrique.example.org
# FABRIQUE_PORT=8080

# Host directory where job workspaces live.
# FABRIQUE_WORK_DIR=/opt/fabrique/work

# Secrets — recommended in production, so they remain separate from the data (otherwise they are generated and kept with it).
# SESSION_SECRET=
# FABRIQUE_SECRET_KEY=

# SSO (OIDC) and Git tokens: adjustable in the dashboard; these variables fix them if you prefer.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# FABRIQUE_ADMINS=
# GIT_BASE_URL=
# GIT_TOKEN=
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
# GITHUB_TOKEN=

# Built-in runner.
# CAPACITY=2
# RUNNER_TAGS=docker
# JOB_MEMORY=4g
# JOB_CPUS=2

# Interface language of last resort (en or fr), when neither the person nor the browser decides. Default: en.
# FABRIQUE_LANG=en
