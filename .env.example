# Fabrique — variables facultatives du fichier compose.yaml. Copier en « .env » et adapter. Aucune n'est obligatoire.

# Nom de la pile : change-le pour faire tourner deux Fabriques sur le même hôte (réseaux, volumes et conteneurs distincts).
# COMPOSE_PROJECT_NAME=fabrique

# Images : par défaut construites depuis ce repo (docker compose --profile images build). Pour les tirer d'un registre :
# FABRIQUE_IMAGES=ghcr.io/<propriétaire>          # images publiées par le workflow GitHub Actions
# FABRIQUE_TAG=latest

# Adresse publique du dashboard (liens des notifications, retour de la connexion unique) et port publié sur l'hôte.
# PUBLIC_URL=https://fabrique.exemple.org
# FABRIQUE_PORT=8080

# Dossier de l'hôte où vivent les workspaces des jobs.
# FABRIQUE_WORK_DIR=/opt/fabrique/travail

# Secrets — recommandé en production, pour qu'ils restent séparés des données (sinon ils sont générés et gardés avec elles).
# SESSION_SECRET=
# FABRIQUE_SECRET_KEY=

# Connexion unique (OIDC) et tokens Git : réglables dans le dashboard ; ces variables les fixent si tu préfères.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# FABRIQUE_ADMINS=
# GIT_BASE_URL=
# GIT_TOKEN=
# GITLAB_BASE_URL=
# GITLAB_TOKEN=
# GITHUB_TOKEN=

# Runner intégré.
# CAPACITY=2
# RUNNER_TAGS=docker
# JOB_MEMORY=4g
# JOB_CPUS=2
